 }
+
+func TestVirtioFsReadOnlyRoundTrip(t *testing.T) {
+	device, err := deviceFromCmdLine("virtio-fs,sharedDir=/tmp/source,mountTag=src,readonly")
+	require.NoError(t, err)
+	share, ok := device.(*VirtioFs)
+	require.True(t, ok)
+	require.True(t, share.ReadOnly)
+	args, err := share.ToCmdLine()
+	require.NoError(t, err)
+	require.Equal(t, []string{"--device", "virtio-fs,sharedDir=/tmp/source,mountTag=src,readonly"}, args)
+	_, err = deviceFromCmdLine("virtio-fs,sharedDir=/tmp/source,readonly=false")
+	require.Error(t, err)
+}
