+func TestDestinationPolicy(t *testing.T) {
+	p, err := NewDestinationPolicy([]string{"100.64.0.0/10", "fd7a:115c:a1e0::/48"}, []string{"100.87.66.65:443", "[fd7a:115c:a1e0::1]:443", "127.0.0.1:443", "[::1]:443"})
