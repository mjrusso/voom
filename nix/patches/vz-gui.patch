+bool showVirtualMachineWindow(void *machine)
+{
+    if (@available(macOS 12, *)) {
+        if (NSApp == nil) return false;
+        __block BOOL shown = NO;
+        void (^show)(void) = ^{
+            if ([NSApp.delegate isKindOfClass:[AppDelegate class]]) {
+                AppDelegate *delegate = (AppDelegate *)NSApp.delegate;
+                if ([delegate ownsVirtualMachine:(VZVirtualMachine *)machine]) {
+                    [delegate showWindow];
+                    shown = YES;
+                }
+            }
+        };
+        if ([NSThread isMainThread]) show();
+        else dispatch_sync(dispatch_get_main_queue(), show);
+        return shown;
+    }
+    return false;
+}
