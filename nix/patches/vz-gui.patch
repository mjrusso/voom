+- (BOOL)ownsVirtualMachine:(VZVirtualMachine *)machine
+{
+    return _virtualMachine == machine;
+}
+
+- (void)showWindow
+{
+    [NSApp unhide:nil];
+    [_window deminiaturize:nil];
+    [_window makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+}
+
+- (BOOL)applicationShouldHandleReopen:(NSApplication *)sender hasVisibleWindows:(BOOL)flag
+{
+    [self showWindow];
+    return YES;
+}
+
+- (BOOL)windowShouldClose:(NSWindow *)sender
+{
+    if (!_keepRunningOnClose) return YES;
+    [sender orderOut:nil];
+    return NO;
+}
+
 - (void)windowWillClose:(NSNotification *)notification
 {
-    [NSApp performSelectorOnMainThread:@selector(terminate:) withObject:self waitUntilDone:NO];
+    if (!_keepRunningOnClose) [NSApp terminate:nil];
+}
+
+- (NSApplicationTerminateReply)applicationShouldTerminate:(NSApplication *)sender
+{
+    if (!_keepRunningOnClose) return NSTerminateNow;
+    __block VZVirtualMachineState state;
+    dispatch_sync(_queue, ^{ state = _virtualMachine.state; });
+    if (state == VZVirtualMachineStateStopped || state == VZVirtualMachineStateError) {
+        return NSTerminateNow;
+    }
+    if (_quitRequested) return NSTerminateCancel;
+    _quitRequested = YES;
+    NSUInteger generation = ++_quitGeneration;
+    dispatch_async(_queue, ^{
+        NSError *error = nil;
+        BOOL accepted = [_virtualMachine requestStopWithError:&error];
+        if (!accepted) {
+            NSString *message = error ? error.localizedDescription : @"The guest did not accept shutdown.";
+            dispatch_async(dispatch_get_main_queue(), ^{
+                _quitRequested = NO;
+                [self showWindow];
+                NSAlert *alert = [[[NSAlert alloc] init] autorelease];
+                alert.messageText = @"Unable to shut down the virtual machine";
+                alert.informativeText = message;
+                [alert beginSheetModalForWindow:_window completionHandler:nil];
+            });
+        }
+    });
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (!_quitRequested || generation != _quitGeneration) return;
+        _quitRequested = NO;
+        [self showWindow];
+        NSAlert *alert = [[[NSAlert alloc] init] autorelease];
+        alert.messageText = @"The virtual machine is still shutting down";
+        alert.informativeText = @"Shut down from inside the guest, or retry Quit. The virtual machine has not been force stopped.";
+        [alert beginSheetModalForWindow:_window completionHandler:nil];
+    });
+    return NSTerminateCancel;
 }
 
