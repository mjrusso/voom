+
+// ShowDisplay focuses the existing window without starting or restarting a VM.
+func (vm *VzVirtualMachine) ShowDisplay(c *gin.Context) {
+	if !vm.GUI {
+		c.JSON(http.StatusConflict, gin.H{"error": "GUI is not enabled"})
+		return
+	}
+	if err := vm.ShowGraphicApplication(); err != nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": err.Error()})
+		return
+	}
+	c.Status(http.StatusAccepted)
+}
