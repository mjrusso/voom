+// Modified by the Voom project; see https://github.com/mjrusso/voom.
 package rest
 
 import (
 	"fmt"
+	"net/http"
+	"net/http/httptest"
 	"net/url"
 	"testing"
 
+	"github.com/gin-gonic/gin"
 	"github.com/stretchr/testify/assert"
 )
 
@@ -153,3 +157,26 @@ func TestToRestScheme(t *testing.T) {
 		})
 	}
 }
+
+type displayVM struct {
+	shows     int
+	mutations int
+}
+
+func (v *displayVM) Inspect(c *gin.Context)     { c.Status(http.StatusOK) }
+func (v *displayVM) GetVMState(c *gin.Context)  { c.Status(http.StatusOK) }
+func (v *displayVM) SetVMState(c *gin.Context)  { v.mutations++; c.Status(http.StatusAccepted) }
+func (v *displayVM) ShowDisplay(c *gin.Context) { v.shows++; c.Status(http.StatusAccepted) }
+
+func TestDisplayEndpointDoesNotChangeVMState(t *testing.T) {
+	vm := &displayVM{}
+	server, err := NewServer(vm, vm, "unix:///tmp/vfkit-test.sock")
+	if err != nil {
+		t.Fatal(err)
+	}
+	response := httptest.NewRecorder()
+	server.router.ServeHTTP(response, httptest.NewRequest(http.MethodPost, "/vm/display", nil))
+	if response.Code != http.StatusAccepted || vm.shows != 1 || vm.mutations != 0 {
+		t.Fatalf("display request: status=%d show=%d state changes=%d", response.Code, vm.shows, vm.mutations)
+	}
+}
